# Use the pooled URL (hostname ending in -pooler) for application traffic.
# src/lib/db.ts disables Prisma's statement cache for pooled Neon connections
# to prevent stale prepared plans after schema changes.
sphere_pharmacy_PRISMA_DATABASE_URL=
sphere_pharmacy_DATABASE_URL=
sphere_pharmacy_POSTGRES_URL=
GROQ_API_KEY=
GROQ_MODEL="openai/gpt-oss-20b"

# Resend Email Integration
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Sphere Pharmacy <notifications@spherepharmacy.co.ke>"

# Firebase Cloud Messaging (FCM) Push Notifications
# Service Account for server-side push dispatch
FIREBASE_PROJECT_ID="sphere-pharmacy-app"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@sphere-pharmacy-app.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional: Full JSON service account key string
# FIREBASE_SERVICE_ACCOUNT_KEY='{"project_id":"...","client_email":"...","private_key":"..."}'

# Public Firebase Web Push Config (client-side)
NEXT_PUBLIC_FIREBASE_PROJECT_ID="sphere-pharmacy-app"
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Safaricom Daraja Lipa Na M-Pesa Online (STK Push)
MPESA_ENVIRONMENT="sandbox" # "sandbox" or "production"
MPESA_CONSUMER_KEY="your_daraja_consumer_key"
MPESA_CONSUMER_SECRET="your_daraja_consumer_secret"
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"
MPESA_SHORTCODE="174379"
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"
MPESA_CALLBACK_URL="https://yourdomain.com/api/payments/mpesa/callback"

# IntaSend Card Payments (Visa / Mastercard)
INTASEND_ENVIRONMENT="sandbox" # "sandbox" or "production"
INTASEND_PUBLISHABLE_KEY="ISPubKey_test_xxxxxxxx"
INTASEND_SECRET_KEY="ISSecretKey_test_xxxxxxxx"
INTASEND_WEBHOOK_SECRET="your_webhook_challenge_or_secret"

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="your_bucket_name"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# Durable notification dispatcher: schedule GET /api/cron/notifications every minute.
# Send Authorization: Bearer <CRON_SECRET>; generate a random value of at least 32 characters.
CRON_SECRET=""
# IntaSend dashboard challenge must exactly match INTASEND_WEBHOOK_SECRET (24+ characters).
# Daraja appends this token to both order and service callback URLs (24+ characters).
MPESA_CALLBACK_TOKEN=""
# Resend signed events endpoint: /api/notifications/email-webhook
RESEND_WEBHOOK_SECRET=""

# Stable 32+ character secrets are required for secure promotion IP/network
# redemption limits, session-based token hashing, and other security features.
# Generate each secret independently (e.g. openssl rand -base64 48).
# Configure in Vercel's Production environment and redeploy after updating.
# Never rotate TOKEN_HASH_SECRET casually: existing HMAC-based redemption
# identifiers must remain comparable across orders and validation requests.
SESSION_SECRET=""
TOKEN_HASH_SECRET=""
OTP_HASH_SECRET=""

# BandaGo POS & CRM Integration (go.bandahealth.org)
BANDAGO_SYNC_API_KEY="sphere_bandago_live_sync_secret_key_2026"
NEXT_PUBLIC_POS_SYNC_SECRET="sphere_bandago_live_sync_secret_key_2026"

