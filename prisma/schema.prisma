generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  name             String?
  phone            String?           @unique
  email            String?           @unique
  passwordHash     String?
  phoneVerifiedAt  DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  loyaltyPoints    Int               @default(0)
  // BandaGo C_BPartner Mapping
  externalBPartnerId   String?          @unique @map("external_bpartner_id")
  loyaltyPointsBalance Int              @default(0) @map("loyalty_points_balance")
  posCreditBalance     Decimal          @default(0.00) @map("pos_credit_balance") @db.Decimal(10, 2)
  isChronicPatient     Boolean          @default(false) @map("is_chronic_patient")
  avatar           String?
  addresses        Address[]
  notifications    Notification[]
  notificationPref NotificationPref?
  orders           Order[]
  prescriptions    Prescription[]
  stockAlerts      ProductAlert[]
  pushTokens       PushToken[]
  reviews          Review[]
  serviceBookings  ServiceBooking[]
  serviceReviews   ServiceReview[]
  sessions         Session[]
  loyaltyEntries   LoyaltyLedger[]

  @@index([externalBPartnerId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String
  text      String
  area      String?
  notes     String?
  isDefault Boolean  @default(false)
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model Session {
  id          String     @id @default(cuid())
  token       String     @unique
  userId      String?
  staffId     String?
  role        String
  expiresAt   DateTime
  createdAt   DateTime   @default(now())
  lastSeenAt  DateTime   @default(now())
  authVersion Int        @default(0)
  staff       StaffUser? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([staffId, expiresAt])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone, used, expiresAt, createdAt])
}

model StaffUser {
  id               String           @id @default(cuid())
  name             String
  email            String           @unique
  phone            String?
  passwordHash     String
  role             String
  title            String?
  active           Boolean          @default(true)
  authVersion      Int              @default(0)
  createdAt        DateTime         @default(now())
  avatar           String?
  notifications    Notification[]
  prescriptions    Prescription[]   @relation("RxReviewer")
  pushTokens       PushToken[]
  assignedBookings ServiceBooking[] @relation("ServiceAssignedStaff")
  serviceReviews   ServiceReview[]
  sessions         Session[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id                   String         @id @default(cuid())
  name                 String
  slug                 String?        @unique
  sku                  String         @unique
  barcode              String?
  categoryId           String?
  brand                String?
  packSize             String?
  price                Decimal        @db.Decimal(12, 2)
  compareAtPrice       Decimal?       @db.Decimal(12, 2)
  costPrice            Decimal?       @map("cost_price") @db.Decimal(12, 2)
  stockStatus          String         @default("IN_STOCK")
  stockQty             Int            @default(0)
  stock                Int?           @default(0)
  virtualReservedStock Int            @default(0) @map("virtual_reserved_stock")
  safetyStockBuffer    Int            @default(2) @map("safety_stock_buffer")
  inStock              Boolean        @default(true) @map("in_stock")
  lowStockThreshold    Int            @default(5)
  requiresPrescription Boolean        @default(false)
  dosageForm           String?        @map("dosage_form")
  strength             String?
  nearestExpiryDate    DateTime?      @map("nearest_expiry_date")
  externalPosId        String?        @unique @map("external_pos_id")
  posSource            String?        @default("BANDAGO") @map("pos_source")
  lastSyncedAt         DateTime?      @map("last_synced_at")
  description          String         @default("")
  usageInfo            String?
  warnings             String?
  image                String?
  active               Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  images               String[]       @default([])
  category             Category?      @relation(fields: [categoryId], references: [id])
  stockAlerts          ProductAlert[]
  reviews              Review[]
  batches              ProductBatch[]

  @@index([externalPosId])
  @@index([inStock, stock])
  @@index([categoryId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  comment   String?
  status    String   @default("PUBLISHED")
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
}

model ProductAlert {
  id         String    @id @default(cuid())
  productId  String
  userId     String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
}

model Order {
  id                   String               @id @default(cuid())
  reference            String               @unique
  userId               String?
  guestName            String?
  guestPhone           String?
  guestEmail           String?
  guestAccessTokenHash String?              @unique
  guestAccessExpiresAt DateTime?
  type                 String
  status               String
  fulfillment          String
  paymentMethod         String? // Checkout choice; null for historical orders
  deliveryAddress      String?
  deliveryArea         String?
  deliveryNotes        String?
  deliveryFee          Decimal              @default(0) @db.Decimal(12, 2)
  deliveryLatitude     Float?
  deliveryLongitude    Float?
  subtotal             Decimal              @db.Decimal(12, 2)
  discountAmount       Decimal              @default(0) @db.Decimal(12, 2)
  promotionCode        String?
  total                Decimal              @db.Decimal(12, 2)
  notes                String?
  pickupCode           String?              @unique
  riderId              String?
  riderName            String?
  pointsEarned         Int                  @default(0)
  pointsRedeemed       Int                  @default(0)
  inventoryReservedAt  DateTime?
  inventoryReleasedAt  DateTime?
  version              Int                  @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  user                 User?                @relation(fields: [userId], references: [id])
  items                OrderItem[]
  statusHistory        OrderStatusHistory[]
  payments             Payment[]
  prescriptions        Prescription[]
  loyaltyEntries       LoyaltyLedger[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([riderId, status, createdAt])
  @@index([guestPhone, createdAt])
  @@index([updatedAt, id])
  @@index([createdAt, id])
}

model OrderItem {
  id                   String  @id @default(cuid())
  orderId              String
  productId            String?
  name                 String
  price                Decimal @db.Decimal(12, 2)
  qty                  Int
  requiresPrescription Boolean @default(false)
  lineTotal            Decimal @db.Decimal(12, 2)
  order                Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  note      String?
  actor     String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model MedicineRequest {
  id           String   @id @default(cuid())
  medicineName String
  phone        String
  status       String   @default("NEW")
  staffNotes   String?
  photoName    String?
  photoType    String?
  storageKey   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
}

model Prescription {
  id             String                  @id @default(cuid())
  userId         String?
  orderId        String?
  fileName       String
  fileType       String
  fileData       String?
  notes          String?
  status         String                  @default("PENDING")
  reviewNotes    String?
  reviewedById   String?
  reviewedAt     DateTime?
  refillsAllowed Int                     @default(0)
  refillsUsed    Int                     @default(0)
  validUntil     DateTime?
  createdAt      DateTime                @default(now())
  fileUrl        String?
  storageKey     String?
  order          Order?                  @relation(fields: [orderId], references: [id])
  reviewedBy     StaffUser?              @relation("RxReviewer", fields: [reviewedById], references: [id])
  user           User?                   @relation(fields: [userId], references: [id])
  accessLogs     PrescriptionAccessLog[]
  deletedAt      DateTime?

  @@index([userId, createdAt])
  @@index([orderId, status])
  @@index([status, createdAt])
}

model PrescriptionAccessLog {
  id             String       @id @default(cuid())
  prescriptionId String
  actorId        String
  actorRole      String
  action         String
  createdAt      DateTime     @default(now())
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId, createdAt])
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String
  provider          String
  method            String?
  status            String   @default("PENDING")
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("KES")
  phone             String?
  cardLast4         String?
  providerReference String?
  checkoutRequestId String?
  idempotencyKey    String?  @unique
  eventId           String?  @unique
  refundReference   String?  @unique
  failureReason     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  webhookEvents     PaymentWebhookEvent[]

  @@unique([provider, providerReference])
  @@unique([provider, checkoutRequestId])
  @@index([orderId, status, createdAt])
}

model Promotion {
  id           String                @id @default(cuid())
  title        String
  description  String
  badge        String?
  code         String?               @unique
  discountPct  Int?
  color        String?
  active       Boolean               @default(true)
  isPublic     Boolean               @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime              @default(now())
  maxUses      Int?
  perUserLimit Int?
  perIpLimit   Int?
  perBrowserLimit Int?
  minimumSpend Decimal?              @db.Decimal(12, 2)
  redemptions  PromotionRedemption[]
}

model PromotionRedemption {
  id          String    @id @default(cuid())
  promotionId String
  orderId     String    @unique
  userId      String?
  ipHash      String?
  browserHash String?
  createdAt   DateTime  @default(now())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId, createdAt])
  @@index([promotionId, userId])
  @@index([promotionId, ipHash])
  @@index([promotionId, browserHash])
}

model LoyaltyLedger {
  id        String   @id @default(cuid())
  eventKey  String   @unique
  userId    String
  orderId   String
  delta     Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([orderId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  actorRole String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId, createdAt])
}

model Notification {
  id        String     @id @default(cuid())
  userId    String?
  channel   String
  event     String?
  title     String
  message   String
  read      Boolean    @default(false)
  createdAt DateTime   @default(now())
  metadata  String?
  staffId   String?
  staff     StaffUser? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([staffId])
}

model NotificationPref {
  id       String  @id @default(cuid())
  userId   String  @unique
  sms      Boolean @default(true)
  whatsapp Boolean @default(true)
  email    Boolean @default(true)
  push     Boolean @default(true)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushToken {
  id        String     @id @default(cuid())
  token     String     @unique
  userId    String?
  staffId   String?
  role      String?
  platform  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  staff     StaffUser? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([staffId])
  @@index([role])
}

model Service {
  id               String                @id @default(cuid())
  name             String
  slug             String                @unique
  shortDescription String?
  description      String?
  category         String?
  durationMinutes  Int                   @default(15)
  price            Decimal?              @db.Decimal(12, 2)
  priceLabel       String?
  heroImage        String?
  featured         Boolean               @default(false)
  active           Boolean               @default(true)
  sortOrder        Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  availability     ServiceAvailability[]
  bookings         ServiceBooking[]
  images           ServiceImage[]
}

model ServiceImage {
  id         String   @id @default(cuid())
  serviceId  String
  url        String
  storageKey String?
  alt        String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServiceAvailability {
  id        String   @id @default(cuid())
  serviceId String
  dayOfWeek Int
  startTime String
  endTime   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, dayOfWeek, startTime, endTime])
  @@index([serviceId, dayOfWeek, enabled])
}

model ServiceBooking {
  id              String                        @id @default(cuid())
  reference       String                        @unique
  serviceId       String
  userId          String
  scheduledStart  DateTime
  scheduledEnd    DateTime
  status          String                        @default("PENDING")
  customerNotes   String?
  staffNotes      String?
  price           Decimal?                      @db.Decimal(12, 2)
  paymentStatus   String                        @default("UNPAID")
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  assignedStaffId String?
  assignedStaff   StaffUser?                    @relation("ServiceAssignedStaff", fields: [assignedStaffId], references: [id])
  service         Service                       @relation(fields: [serviceId], references: [id])
  user            User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  statusHistory   ServiceBookingStatusHistory[]
  payments        ServicePayment[]
  reviews         ServiceReview[]

  @@index([serviceId, scheduledStart, scheduledEnd])
  @@index([userId, scheduledStart])
  @@index([status])
  @@index([scheduledStart, id])
  @@index([status, scheduledStart, id])
  @@index([assignedStaffId, scheduledStart])
  @@index([updatedAt, id])
  @@index([createdAt, id])
}

model ServiceBookingStatusHistory {
  id        String         @id @default(cuid())
  bookingId String
  status    String
  note      String?
  actor     String
  createdAt DateTime       @default(now())
  booking   ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

model ServicePayment {
  id                String         @id @default(cuid())
  bookingId         String
  provider          String
  method            String?
  status            String         @default("PENDING")
  amount            Decimal        @db.Decimal(12, 2)
  currency          String         @default("KES")
  phone             String?
  providerReference String?
  checkoutRequestId String?
  idempotencyKey    String?         @unique
  eventId           String?        @unique
  failureReason     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  booking           ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  webhookEvents     PaymentWebhookEvent[]

  @@unique([provider, providerReference])
  @@unique([provider, checkoutRequestId])
  @@index([bookingId, status])
}

model PaymentWebhookEvent {
  id               String          @id @default(cuid())
  provider         String
  eventId          String          @unique
  payloadHash      String
  paymentId        String?
  servicePaymentId String?
  createdAt        DateTime        @default(now())
  payment          Payment?        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  servicePayment   ServicePayment? @relation(fields: [servicePaymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([servicePaymentId, createdAt])
}

model ServiceReview {
  id        String         @id @default(cuid())
  bookingId String
  userId    String
  staffId   String?
  rating    Int
  comment   String?
  status    String         @default("PUBLISHED")
  createdAt DateTime       @default(now())
  booking   ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff     StaffUser?     @relation(fields: [staffId], references: [id])
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookingId, userId])
  @@index([userId])
}

model Setting {
  key   String @id
  value String
}

model RateLimitBucket {
  key        String   @id
  count      Int      @default(0)
  windowEnds DateTime
  updatedAt  DateTime @updatedAt

  @@index([windowEnds])
}

model ScheduledJobDelivery {
  key       String   @id
  sentAt    DateTime?
  createdAt DateTime @default(now())
}

// Durable, independently retried provider deliveries. SENT means provider accepted.
model NotificationDelivery {
  id          String   @id @default(cuid())
  dedupeKey   String   @unique
  userId      String?
  staffId     String?
  channel     String
  payload     Json
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  availableAt DateTime @default(now())
  lockedUntil DateTime?
  lockToken   String?
  providerId  String?
  lastError   String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, availableAt])
}

model EmailSuppression {
  email String @id
  reason String
  createdAt DateTime @default(now())
}

model EmailDeliveryEvent {
  id String @id
  providerId String
  status String
  processed Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([processed, createdAt])
}

// =========================================================================
// ENUMS FOR POS INTEGRATION
// =========================================================================

enum PosSyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}

enum PosSyncTrigger {
  EXTENSION_STREAM
  BACKGROUND_POLL
  CSV_IMPORT
  MANUAL_RECONCILE
}

// =========================================================================
// PRODUCT & BATCH EXTENSIONS
// =========================================================================

model ProductBatch {
  id                String    @id @default(cuid())
  productId         String    @map("product_id")
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  batchNumber       String    @map("batch_number") // iDempiere Lot/Batch
  quantityOnHand    Int       @map("quantity_on_hand")
  expiryDate        DateTime  @map("expiry_date") // iDempiere M_AttributeSetInstance.GuaranteeDate
  externalBatchId   String?   @map("external_batch_id")
  isExpired         Boolean   @default(false) @map("is_expired")
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([productId, batchNumber])
  @@index([productId, expiryDate])
  @@map("product_batches")
}

// =========================================================================
// POS INTEGRATION TELEMETRY & AUDIT LOGS
// =========================================================================

model PosSyncLog {
  id               String         @id @default(cuid())
  posSource        String         @default("BANDAGO") @map("pos_source")
  trigger          PosSyncTrigger @default(EXTENSION_STREAM)
  status           PosSyncStatus  @default(SUCCESS)
  
  itemsReceived    Int            @default(0) @map("items_received")
  itemsUpserted    Int            @default(0) @map("items_upserted")
  itemsFailed      Int            @default(0) @map("items_failed")
  
  details          Json?          // Stores error stacks, category assignments, diff logs
  startedAt        DateTime       @default(now()) @map("started_at")
  completedAt      DateTime?      @map("completed_at")
  durationMs       Int?           @map("duration_ms")

  @@index([startedAt])
  @@index([status])
  @@map("pos_sync_logs")
}

